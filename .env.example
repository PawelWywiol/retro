TZ=Etc/UTC
PUID=1000
PGID=1000

# Game library root: roms/<es-de system>, bios/
LIBRARY_PATH=/srv/retro/library
# App state: romm resources/assets/config, database, redis, minerva, gluetun
DATA_PATH=/srv/retro/data

ROMM_PORT=8080
MINERVA_PORT=8090

DB_NAME=romm
DB_USER=romm
DB_PASSWD=
DB_ROOT_PASSWD=
ROMM_AUTH_SECRET_KEY=

# Metadata providers, all optional: https://docs.romm.app/latest/Getting-Started/Metadata-Providers/
SCREENSCRAPER_USER=
SCREENSCRAPER_PASSWORD=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
MOBYGAMES_API_KEY=
STEAMGRIDDB_API_KEY=
RETROACHIEVEMENTS_API_KEY=
HASHEOUS_API_ENABLED=true
LAUNCHBOX_API_ENABLED=false
PLAYMATCH_API_ENABLED=false

# VPN for minerva-helper: https://github.com/qdm12/gluetun-wiki
VPN_SERVICE_PROVIDER=
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
SERVER_COUNTRIES=

MINERVA_VERSION=v0.1.3
