{
  "name": "retro",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted retro gaming stack: RomM, minerva-helper behind gluetun",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "pnpm lint:sh && pnpm lint:actions && pnpm lint:compose",
    "lint:sh": "docker run --rm -v \"$PWD:/mnt\" koalaman/shellcheck:v0.11.0 scripts/init.sh",
    "lint:actions": "docker run --rm -u \"$(id -u):$(id -g)\" -v \"$PWD:/repo\" -w /repo rhysd/actionlint:1.7.12 -color",
    "lint:compose": "DB_PASSWD=ci DB_ROOT_PASSWD=ci ROMM_AUTH_SECRET_KEY=ci docker compose --env-file .env.example --profile minerva config --quiet",
    "secrets": "docker run --rm -v \"$PWD:/repo\" zricethezav/gitleaks:v8.30.1 git --redact --verbose /repo",
    "audit": "pnpm dlx audit-ci@7.1.0 --config ./audit-ci.jsonc",
    "deps:check": "pnpm outdated --include-github-actions",
    "release": "commit-and-tag-version --no-verify"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "commit-and-tag-version": "13.3.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.75.0"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@12.16.1"
}
